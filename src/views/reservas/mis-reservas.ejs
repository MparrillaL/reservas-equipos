<%- include('../partials/cabecera') %>
<h1>Mis reservas</h1>
<p><a href="/reservas/nueva">+ Nueva reserva</a></p>
<% if (reservas.length === 0) { %>
  <p>No tienes reservas.</p>
<% } else { %>
  <table>
    <thead><tr><th>Equipo</th><th>Fecha</th><th>Turno</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% for (const r of reservas) { %>
        <tr>
          <td><%= r.equipo ? r.equipo.nombre : 'Equipo eliminado' %></td>
          <td><%= r.fecha %></td>
          <td><%= r.turno === 'manana' ? 'Mañana' : 'Tarde' %></td>
          <td><%= r.estado %></td>
          <td>
            <% if (r.puedeCancelar) { %>
              <form method="post" action="/reservas/<%= r.id %>/cancelar" class="en-linea">
                <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
                <button type="submit">Cancelar</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
<% } %>
<%- include('../partials/pie') %>