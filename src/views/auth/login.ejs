<%- include('../partials/cabecera') %>
<h1>Iniciar sesión</h1>
<% if (locals.esDesarrollo) { %>
  <aside class="ayuda-dev">
    <strong>Solo desarrollo · usuarios de prueba</strong>
    <ul>
      <li>admin@example.com / Admin1234 (admin)</li>
      <li>ana@example.com / Ana12345</li>
      <li>luis@example.com / Luis12345</li>
    </ul>
  </aside>
<% } %>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/login" novalidate>
  <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
  <p><label>Correo<br><input type="email" name="email" value="<%= valores.email || '' %>"></label></p>
  <p><label>Contraseña<br><input type="password" name="password"></label></p>
  <button type="submit">Entrar</button>
</form>
<p>¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
<%- include('../partials/pie') %>